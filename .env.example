# Optional — community orgs, petitions, polls, and votes work without these.
# Used only for on-chain group/registry screens against a local Anvil node.
NEXT_PUBLIC_GROUP_REGISTRY=
NEXT_PUBLIC_IDENTITY_ADDRESS=

# Optional. Without DATABASE_URL, data stays in data/*.json (gitignored).
DATABASE_URL=

# Required to encrypt community-org ballots. Use a long random string.
BALLOT_ENCRYPTION_KEY=
